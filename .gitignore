# Build output.
#
# The `target*/` form also covers the per-experiment build directories that
# benchmarking creates (`target-native`, `target-cpu`, ...). Ignoring only
# `/target` once let several thousand build artifacts into a commit.
/target*/

# Training data and checkpoints are never committed.
/artifacts/*
!/artifacts/.gitkeep

# Experiment run directories (resolved config, manifest, metrics, checkpoints).
/runs/

# Model and checkpoint artifacts
*.bpk
*.safetensors
*.mpk
